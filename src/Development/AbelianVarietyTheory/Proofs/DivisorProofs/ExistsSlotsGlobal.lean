  | algebraMap q => exact σ.commutes q
  | add a b _ _ ha hb => rw [map_add (f := _), ha, hb]
  | inv a _ ha => rw [map_inv₀, ha]
  | mul a b _ _ ha hb => rw [map_mul, ha, hb]

