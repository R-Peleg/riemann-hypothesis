def ring (j : Ω →+* PadicAlgCl l) : ValuationSubring Ω :=
  ((NormedField.valuation (K := PadicAlgCl l)).comap j).valuationSubring

theorem mem_ring (j : Ω →+* PadicAlgCl l) (x : Ω) : x ∈ ring j ↔ ‖j x‖ ≤ 1 := by
