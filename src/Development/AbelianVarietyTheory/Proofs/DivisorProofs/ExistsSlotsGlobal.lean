theorem mem_fix (τ : E →+* PadicAlgCl l) (σ : PadicAlgCl l ≃ₐ[ℚ_[l]] PadicAlgCl l) :
    σ ∈ (compl τ).fixingSubgroup ↔ ∀ x, σ (τ x) = τ x := by
